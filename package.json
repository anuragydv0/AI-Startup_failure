{
  "name": "deadpool-ai",
  "version": "1.0.0",
  "description": "A classified AI startup autopsy platform. Upload your pitch deck and let DEADPOOL AI brutally analyze why your startup will fail before investors reject it.",
  "keywords": [
    "deadpool",
    "deadpool-ai",
    "pitch-deck-autopsy",
    "startup-failure",
    "pitch-deck-roast"
  ],
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--openssl-legacy-provider next dev",
    "build": "cross-env NODE_OPTIONS=--openssl-legacy-provider next build",
    "clean": "node -e \"require('fs').rmSync('.next', { recursive: true, force: true }); console.log('Cleared .next cache')\"",
    "rebuild": "npm run clean && npm run build",
    "start": "cross-env NODE_OPTIONS=--openssl-legacy-provider next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@radix-ui/react-slot": "^1.2.4",
    "@react-three/drei": "^9.58.0",
    "@react-three/fiber": "^8.13.3",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.1",
    "@tanstack/react-query": "^5.100.11",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/three": "^0.184.1",
    "autoprefixer": "^10.4.0",
    "axios": "^1.16.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "fast-xml-parser": "^5.8.0",
    "framer-motion": "^10.16.4",
    "gsap": "^3.12.2",
    "jszip": "^3.10.1",
    "lenis": "^1.0.0",
    "lucide-react": "^0.294.0",
    "next": "^16.2.6",
    "pdf-parse": "^2.4.5",
    "postcss": "^8.4.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^15.0.0",
    "tailwind-merge": "^2.2.0",
    "tailwindcss": "^3.3.0",
    "three": "^0.184.0",
    "typescript": "^5.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "eslint": "^8.50.0",
    "eslint-config-next": "^14.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "prettier": "^3.3.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,css,md}": [
      "prettier --write"
    ],
    "*.{js,jsx,ts,tsx}": [
      "next lint --fix --file"
    ]
  }
}
